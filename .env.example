# ============================================================================
# WebSSH configuration. Copy to .env and edit:  cp .env.example .env && chmod 600 .env
# ============================================================================

# --- Required ---------------------------------------------------------------
# The exact URL you open in the browser (used for cookies, CSRF/origin checks and passkeys).
PUBLIC_URL=https://webssh.lucafchala.com

# 32-byte key that encrypts saved SSH passwords, private keys, TOTP secrets and AI keys.
# Generate with:  openssl rand -base64 32
# Keep a copy in your password manager — without it the encrypted data is unrecoverable.
MASTER_KEY=

# Cloudflare Tunnel token (docs/CLOUDFLARE.md or deploy/cloudflare-setup.sh print it).
CLOUDFLARE_TUNNEL_TOKEN=

# --- Defence in depth: Cloudflare Access (recommended) ----------------------
# When set, every request must carry a valid Cloudflare Access JWT, so the app is
# unreachable without passing your Access login (email one-time PIN / Google / GitHub…).
# Team domain looks like  yourteam.cloudflareaccess.com ; AUD is the application's "Audience tag".
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- Login security ----------------------------------------------------------
# Require TOTP or a passkey for every account (strongly recommended).
REQUIRE_2FA=true
# Lock an account for LOGIN_LOCK_MINUTES after LOGIN_MAX_ATTEMPTS wrong passwords.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Sign-in lifetime: idle timeout and absolute maximum.
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
# Optional one-time token for creating the first admin (otherwise a random one is printed in the logs).
SETUP_TOKEN=

# --- Network restrictions ------------------------------------------------------
# Only allow these client IPs/CIDRs to reach the app (empty = everyone who passes Cloudflare).
IP_ALLOWLIST=
# Only allow SSH connections to these networks — limits damage if an account is ever compromised.
# Example for a typical home LAN + Tailscale:  192.168.0.0/16,10.0.0.0/8,100.64.0.0/10,172.16.0.0/12
SSH_TARGET_ALLOWLIST=
# Which proxies may set X-Forwarded-For. The default trusts private ranges (the cloudflared container).
# If you publish port 8080 on your LAN, set this to your reverse proxy's IP only.
TRUST_PROXY=loopback,linklocal,uniquelocal

# --- Terminals -------------------------------------------------------------------
# How long a shell keeps running after you close the tab / lose network (re-attach from any device).
TERMINAL_GRACE_MINUTES=30
MAX_SESSIONS_PER_USER=20
SCROLLBACK_LINES=5000
RECORDINGS_RETENTION_DAYS=30
MAX_UPLOAD_MB=2048

# --- AI assistant (optional; can also be configured in Admin → Settings) ---------
# Free & private: run Ollama with `docker compose --profile ai up -d` and pull a model:
#   docker exec webssh-ollama ollama pull qwen2.5-coder:7b
# AI_PROVIDER=ollama
# AI_BASE_URL=http://ollama:11434/v1
# AI_MODEL=qwen2.5-coder:7b
#
# Claude (paid API, best quality):
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5-5
#
# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, LM Studio, vLLM…):
# AI_PROVIDER=openai
# AI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=...
# AI_MODEL=...

# --- Command help ------------------------------------------------------------------
# Fetch community examples from tldr-pages (GitHub) for commands not in the offline guide.
TLDR_ENABLED=true

# --- Misc ---------------------------------------------------------------------------
LOG_LEVEL=info
# HOST=0.0.0.0
# PORT=8080
# DATA_DIR=/data
