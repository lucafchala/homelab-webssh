{
  "name": "webssh-homelab",
  "version": "1.0.0",
  "private": true,
  "description": "Secure, mobile-friendly web SSH console for your homelab: terminals, SFTP, monitoring, snippets, command help and an AI assistant.",
  "keywords": [
    "ssh",
    "web-ssh",
    "homelab",
    "self-hosted",
    "terminal",
    "xterm",
    "sftp",
    "cloudflare-tunnel",
    "2fa",
    "passkeys",
    "docker",
    "ai-assistant",
    "ollama",
    "claude"
  ],
  "homepage": "https://github.com/lucafchala/webssh.lucafchala.com#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucafchala/webssh.lucafchala.com.git"
  },
  "bugs": {
    "url": "https://github.com/lucafchala/webssh.lucafchala.com/issues"
  },
  "author": "lucafchala",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --disable-warning=ExperimentalWarning server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning server/dist/index.js",
    "cli": "node --disable-warning=ExperimentalWarning server/dist/cli.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "@simplewebauthn/server": "^14.0.3",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "qrcode": "^1.5.4",
    "ssh2": "^1.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@playwright/test": "^1.63.0",
    "@preact/signals": "^2.11.3",
    "@simplewebauthn/browser": "^14.0.0",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.5",
    "lucide-preact": "^1.50.0",
    "preact": "^10.29.8",
    "tsx": "^4.23.15",
    "typescript": "~7.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
